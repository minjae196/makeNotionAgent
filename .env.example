# Notion API 설정
# 1. Notion API Key: https://www.notion.so/profile/integrations 에서 발급한 secret 토큰
NOTION_API_KEY=secret_your_notion_api_key_here

# 2. Notion Database ID (제공해주신 URL에서 추출 완료)
NOTION_DATABASE_ID=3c062085085e80058a56fb06345ace8f

# 3. LLM API Key (Google Gemini API Key)
GEMINI_API_KEY=your_gemini_api_key_here
